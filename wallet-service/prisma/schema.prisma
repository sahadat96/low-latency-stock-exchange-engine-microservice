
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED

  @@map("wallet_status")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE_DEBIT
  TRADE_CREDIT

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED

  @@map("transaction_status")
}

enum Currency {
  USD
  BTC
  ETH
  USDT

  @@map("currency")
}

// ============================================================
// WALLET
// ============================================================

model Wallet {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid

  currency         Currency         @default(USD)

  availableBalance Decimal          @default(0) @map("available_balance") @db.Decimal(30, 8)
  lockedBalance    Decimal          @default(0) @map("locked_balance") @db.Decimal(30, 8)

  status           WalletStatus     @default(ACTIVE)

  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@map("wallets")
}

